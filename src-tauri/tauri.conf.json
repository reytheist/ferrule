{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ferrule",
  "version": "0.2.1",
  "identifier": "org.ferrule.mail",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ferrule",
        "width": 1280,
        "height": 820,
        "minWidth": 820,
        "minHeight": 580,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; frame-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "copyright": "Copyright (c) Ferrule Contributors",
    "licenseFile": "LICENSE-INSTALLER.txt",
    "shortDescription": "Low-memory email and staff collaboration client",
    "longDescription": "Local-first desktop email, shared calendar, and Pigment Staff collaboration client built with Tauri v2 and Rust.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "section": "mail"
      }
    }
  }
}
